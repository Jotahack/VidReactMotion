# Copiar a .env. No subir claves reales a Git.
AI_PROVIDER=lmstudio
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=
AI_MODEL=
API_PORT=3131

# Para API externa compatible con OpenAI:
# AI_PROVIDER=compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=tu_clave
# AI_MODEL=tu_modelo

# Gemini — alternativa para evaluar la calidad del mismo director creativo:
# AI_PROVIDER=gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=tu_clave_de_google_ai_studio
# AI_MODEL=nombre_del_modelo_disponible
